# Waitlist form → email delivery (https://resend.com)
# Without RESEND_API_KEY, submissions are only logged to the server console (dev fallback).
RESEND_API_KEY=
WAITLIST_NOTIFY_EMAIL=info@auxiodev.com
WAITLIST_FROM_EMAIL=DocGet Waitlist <waitlist@medoroapp.com>

# medalize_be base URL — the doctor/hospital share-preview pages
# (/[locale]/doctor/[id], /[locale]/hospital/[id]) fetch the public,
# unauthenticated profile endpoints from here server-side.
BACKEND_API_URL=http://localhost:8000

# Universal Links / App Links (QR_SHARE_PROFILE_PLAN.md Phase 3) — served at
# /.well-known/apple-app-site-association and /.well-known/assetlinks.json.
# Without real values here, a share link/QR scan never opens the app, even
# with the app installed — it just silently falls back to the web page.
# APPLE_TEAM_ID: Apple Developer > Membership > Team ID.
APPLE_TEAM_ID=
# ANDROID_SHA256_CERT_FINGERPRINTS: comma-separated if more than one (e.g. a
# debug keystore's fingerprint alongside the Play Store release key).
# `keytool -list -v -keystore <path>`, or Play Console > Setup > App
# integrity > App signing key certificate.
ANDROID_SHA256_CERT_FINGERPRINTS=
